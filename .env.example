# Template for local IDE development. Copy to .env and load it into your
# run configuration (or export manually) - Postgres/Kafka/Redis run via
# `docker compose up -d` for Kafka/Redis; Postgres is a native local install.

SPRING_PROFILES_ACTIVE=dev

DB_HOST=localhost
DB_PORT=5432
DB_NAME=coryd
DB_USERNAME=coryd
DB_PASSWORD=coryd

JWT_SECRET=local-dev-secret-not-for-production
JWT_EXPIRATION_MS=86400000

# Shared across profile-service, identity-service, trip-service - gates the
# service-to-service-only endpoints (batch lookups, cross-service contact
# fetches) on top of the normal JWT check. Same value everywhere.
INTERNAL_API_KEY=local-dev-internal-key-not-for-production

KAFKA_SERVERS=localhost:9092
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=1

PAYSTACK_SECRET_KEY=sk_test_replace_me
COMMISSION_PERCENTAGE=0.05

TERMII_ENABLED=false
TERMII_API_KEY=replace_me
TERMII_SENDER_ID=OE Alert

GOOGLE_MAPS_API_KEY=replace_me

# Path to your local Firebase service-account JSON (see docs/firebase-fcm.md).
# Missing/unreadable file just disables push locally - no crash.
FIREBASE_CREDENTIALS_PATH=firebase-service-account.json

# Ops reports (notification-service) - daily 06:00, weekly Mon 06:05, monthly 1st 06:10
REPORT_ENABLED=true
REPORT_TIMEZONE=Africa/Lagos
# Comma-separated - add as many as you need
REPORT_RECIPIENTS=hello@coryd.ng,victor.oyeks@coryd.ng
REPORT_LOGO_URL=

# Driver document gate: STRICT | GRACE | OFF
DRIVER_VERIFICATION_ENFORCEMENT=GRACE
DRIVER_VERIFICATION_GRACE_DAYS=30
# Identity/vehicle gate: SUBMITTED | APPROVED (APPROVED needs an ops reviewer)
DRIVER_PREREQUISITE_LEVEL=APPROVED
