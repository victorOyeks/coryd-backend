# Template for local IDE development. Copy to .env and load it into your
# run configuration (or export manually) - Postgres/Kafka/Redis run via
# `docker compose up -d` for Kafka/Redis; Postgres is a native local install.

SPRING_PROFILES_ACTIVE=dev

DB_HOST=localhost
DB_PORT=5432
DB_NAME=coryd
DB_USERNAME=coryd
DB_PASSWORD=coryd

JWT_SECRET=local-dev-secret-not-for-production
JWT_EXPIRATION_MS=86400000

KAFKA_SERVERS=localhost:9092
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=1

PAYSTACK_SECRET_KEY=sk_test_replace_me
COMMISSION_PERCENTAGE=0.15

TERMII_API_KEY=replace_me
TERMII_SENDER_ID=CoRyd

GOOGLE_MAPS_API_KEY=replace_me
