# Template for /opt/coryd-dev/.env.dev on the shared app VPS (same box as
# marketrun-dev). Copy this file there, fill in real values, and NEVER commit
# the filled-in version. Loaded by each systemd unit via EnvironmentFile=.

# Without this, every service runs under Spring's "default" profile, not
# "dev" - application-dev.yml never loads, and the fixed 000333 OTP
# (identity-service only activates it under dev/test) never kicks in.
SPRING_PROFILES_ACTIVE=dev

DB_HOST=localhost
DB_PORT=5432
DB_NAME=coryd
DB_USERNAME=coryd_user
DB_PASSWORD=change-me

JWT_SECRET=change-me-generate-a-long-random-value
JWT_EXPIRATION_MS=86400000

# Shared across profile-service, identity-service, trip-service - gates the
# service-to-service-only endpoints (batch lookups, cross-service contact
# fetches) on top of the normal JWT check. Same value everywhere.
INTERNAL_API_KEY=change-me-generate-a-long-random-value

# CoRyd shares marketrun-ng's existing Kafka/Redis on this VPS (default
# ports) - isolation comes from the "coryd-" topic/group-id prefix (baked
# into the code) and a dedicated Redis logical DB, not separate ports/containers.
# Using 127.0.0.1 explicitly, not "localhost" - marketrun-ng's Kafka container
# only publishes on IPv4, and the JVM resolving "localhost" to ::1 first causes
# connection-refused flakiness on startup (confirmed via `nc -zv localhost 9092`).
KAFKA_SERVERS=127.0.0.1:9092
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=1

PAYSTACK_SECRET_KEY=sk_test_replace_with_real_key
COMMISSION_PERCENTAGE=0.05

TERMII_ENABLED=false
TERMII_API_KEY=replace_me
TERMII_SENDER_ID=OE Alert

GOOGLE_MAPS_API_KEY=replace_me

PROFILE_SERVICE_URL=http://localhost:9102/profile
IDENTITY_SERVICE_URL=http://localhost:9101/identity
TRIP_SERVICE_URL=http://localhost:9103/trip

SHARE_LINK_SECRET=change-me-generate-a-long-random-value
SHARE_LINK_BASE_URL=https://api-dev.coryd.ng/trip

# Absolute path, not relative - the notification-service systemd unit has no
# WorkingDirectory set, so a relative path here would resolve against "/",
# not the app's own directory. See docs/firebase-fcm.md for how to get this
# file onto the VPS. If it's missing/unreadable, FirebaseConfig logs an error
# and the service still starts - pushes are just skipped, DB notifications
# still save.
FIREBASE_CREDENTIALS_PATH=/opt/coryd-dev/firebase-service-account.json

# Ops reports (notification-service) - daily 06:00, weekly Mon 06:05, monthly 1st 06:10
REPORT_ENABLED=true
REPORT_TIMEZONE=Africa/Lagos
# Comma-separated - add as many as you need
REPORT_RECIPIENTS=hello@coryd.ng,victor.oyeks@coryd.ng
REPORT_LOGO_URL=

# --- Safety -------------------------------------------------------------------------------------
# notification-service: every SOS, and every unanswered "Are you OK?" check, is texted to each ops
# phone and emailed to each ops address (comma-separated). Empty = ops hear nothing.
SOS_OPS_PHONES=
SOS_OPS_EMAILS=
# trip-service: STRICT (default) - nobody books (riders) or posts routes (drivers) until their NIN +
# selfie check is approved. OFF only where nobody can be verified yet.
IDENTITY_VERIFICATION_ENFORCEMENT=STRICT
# trip-service: "Are you OK?" checks on trips in progress
TRIP_SAFETY_ENABLED=true
# Stopped = within this many metres for this many minutes, away from the start/end/pickups/drop-offs
TRIP_SAFETY_STOP_RADIUS_METERS=50
TRIP_SAFETY_STOP_MINUTES=10
TRIP_SAFETY_KNOWN_STOP_RADIUS_METERS=300
# Off route = this far from the line planned at departure, for this long
TRIP_SAFETY_OFF_ROUTE_METERS=1000
TRIP_SAFETY_OFF_ROUTE_MINUTES=5
# No location from the driver's phone for this long
TRIP_SAFETY_SIGNAL_LOST_MINUTES=10
# Unanswered for this long -> ops is texted and emailed
TRIP_SAFETY_ANSWER_MINUTES=3

# Driver document gate: STRICT | GRACE | OFF
DRIVER_VERIFICATION_ENFORCEMENT=GRACE
DRIVER_VERIFICATION_GRACE_DAYS=30
# Identity/vehicle gate: SUBMITTED | APPROVED (APPROVED needs an ops reviewer)
DRIVER_PREREQUISITE_LEVEL=APPROVED

# Smile ID - the NIN + live selfie check (everyone) and the driver's licence check (profile-service).
# CoRyd uses Smile ID's live environment only: a production API key with SMILE_ID_SANDBOX=false.
# Without a partner ID and key, both checks answer "unavailable". Never commit a real key.
SMILE_ID_PARTNER_ID=
SMILE_ID_API_KEY=
SMILE_ID_SANDBOX=false
# Blank = the callback URL set for this environment in the Smile ID portal (recommended):
# https://<api host>/profile/webhooks/smile-id
SMILE_ID_CALLBACK_URL=https://api-dev.coryd.ng/profile/webhooks/smile-id
# NIN_V2 needs an NIMC enterprise ID on the Smile ID account; NIN_SLIP is the fallback
SMILE_ID_ID_TYPE=NIN_V2
# How close the NIMC name must be to the profile name, 0-1
SMILE_ID_NAME_MATCH_THRESHOLD=0.85

# auto (T+1) | weekly | monthly. Never "manual" - Paystack treats that as conditional release.
PAYSTACK_SETTLEMENT_SCHEDULE=weekly
# Must stay inside the settlement cycle, or a trip can depart after the driver has been paid
TRIP_MAX_DAYS_AHEAD=3
# Who pays Paystack's fee on a split charge (account | subaccount | all). Verify in test mode first.
PAYSTACK_SPLIT_FEE_BEARER=
# Paystack test mode only resolves 3 real bank accounts a day. 001 is Paystack's test bank: accounts
# are sent to Paystack as that bank while the driver's own details are stored and shown. Ignored with
# a live (sk_live_) key. Leave empty to test against real banks.
PAYSTACK_TEST_BANK_CODE=001
# Paystack's test bank works for lookups but not subaccounts. Create one subaccount by hand in the
# Paystack dashboard (Test mode) and put its ACCT_ code here; every test driver's fares split to it.
# Ignored with a live key.
PAYSTACK_TEST_SUBACCOUNT_CODE=
# A driver owing more than this (naira) from refunded trips can't post routes until they pay it back.
DRIVER_OWED_LIMIT=10000

# --- Matching (trip-service) --------------------------------------------------------------------
# End-to-end matches: the trip must leave within this many minutes of the rider's time, and start and
# end within this many metres of the rider's. Commuter defaults; widen only if searches come back empty.
MATCHING_TIME_TOLERANCE_MINUTES=60
MATCHING_GEO_TOLERANCE_METERS=2000
# Along the way: riders whose start and end are both within MATCHING_WALK_METERS of a driver's road.
# false also lifts the "pickup must be on the driver's road" booking rule (e.g. until the app sends it).
MATCHING_ALONG_ROUTE_ENABLED=true
MATCHING_WALK_METERS=1000
# Longest trip assumed when looking for routes that pass a rider after they left their start
MATCHING_MAX_TRIP_MINUTES=240
# Use PostGIS for along-the-way candidates when the database has it; false forces the in-memory path
MATCHING_USE_POSTGIS=true

# --- Regular routes and rider demand (trip-service) ---------------------------------------------
# How often regular routes post their upcoming trips (Spring cron, Lagos time)
ROUTE_TEMPLATES_CRON=0 5 * * * *
# Drivers see a wanted route once this many riders want it; the 7 PM push needs this many
DEMAND_MIN_RIDERS_SHOWN=3
DEMAND_MIN_RIDERS_FOR_ALERT=5
# How close a driver's own trips must start/end to count as "your route", in km
DEMAND_MATCH_RADIUS_KM=5
DEMAND_MAX_ALERTS_PER_WEEK=3

# --- Email (notification-service) ---------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=replace_me
SMTP_PASSWORD=replace_me
MAIL_FROM_ADDRESS=no-reply@coryd.ng
MAIL_FROM_NAME=CoRyd

# --- Media uploads (profile-service) ------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=replace_me
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me

# --- Service-to-service URLs and gateway routing -------------------------------------------------
# Defaults point at localhost; set only if a service runs elsewhere.
PAYMENT_SERVICE_URL=http://localhost:9104/payment
NOTIFICATION_SERVICE_URL=http://localhost:9105/notification
# api-gateway: hosts it routes /identity, /profile, /trip, /payment, /notification, /ops to
IDENTITY_HOST=localhost
PROFILE_HOST=localhost
TRIP_HOST=localhost
PAYMENT_HOST=localhost
NOTIFICATION_HOST=localhost
OPS_HOST=localhost
# api-gateway: website origins allowed to post the beta waitlist form (comma-separated)
BETA_FORM_ALLOWED_ORIGINS=https://coryd.ng,https://www.coryd.ng

# --- Payments (payment-service) -----------------------------------------------------------------
# How often Paystack settlements are synced (Spring cron)
PAYMENT_SETTLEMENT_SYNC_CRON=0 15 */6 * * *

# --- Dev / test only ----------------------------------------------------------------------------
# Lets trips be started and tracked outside their time window, for testing. Never true in production.
BYPASS_TIME_GATES=false
# Dev tools endpoints (trip/payment purge and reset). Never true in production.
DEV_TOOLS_ENABLED=false
# Kafka consumers: latest (default) skips a stale backlog after downtime; earliest replays it
KAFKA_AUTO_OFFSET_RESET=latest
