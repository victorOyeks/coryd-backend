# Template for /opt/coryd-dev/.env.dev on the shared app VPS (same box as
# marketrun-dev). Copy this file there, fill in real values, and NEVER commit
# the filled-in version. Loaded by each systemd unit via EnvironmentFile=.

# Without this, every service runs under Spring's "default" profile, not
# "dev" - application-dev.yml never loads, and the fixed 000333 OTP
# (identity-service only activates it under dev/test) never kicks in.
SPRING_PROFILES_ACTIVE=dev

DB_HOST=localhost
DB_PORT=5432
DB_NAME=coryd
DB_USERNAME=coryd_user
DB_PASSWORD=change-me

JWT_SECRET=change-me-generate-a-long-random-value
JWT_EXPIRATION_MS=86400000

# Shared across profile-service, identity-service, trip-service - gates the
# service-to-service-only endpoints (batch lookups, cross-service contact
# fetches) on top of the normal JWT check. Same value everywhere.
INTERNAL_API_KEY=change-me-generate-a-long-random-value

# CoRyd shares marketrun-ng's existing Kafka/Redis on this VPS (default
# ports) - isolation comes from the "coryd-" topic/group-id prefix (baked
# into the code) and a dedicated Redis logical DB, not separate ports/containers.
# Using 127.0.0.1 explicitly, not "localhost" - marketrun-ng's Kafka container
# only publishes on IPv4, and the JVM resolving "localhost" to ::1 first causes
# connection-refused flakiness on startup (confirmed via `nc -zv localhost 9092`).
KAFKA_SERVERS=127.0.0.1:9092
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=1

PAYSTACK_SECRET_KEY=sk_test_replace_with_real_key
COMMISSION_PERCENTAGE=0.05

TERMII_ENABLED=false
TERMII_API_KEY=replace_me
TERMII_SENDER_ID=OE Alert

GOOGLE_MAPS_API_KEY=replace_me

PROFILE_SERVICE_URL=http://localhost:9102/profile
IDENTITY_SERVICE_URL=http://localhost:9101/identity
TRIP_SERVICE_URL=http://localhost:9103/trip

SHARE_LINK_SECRET=change-me-generate-a-long-random-value
SHARE_LINK_BASE_URL=https://api-dev.coryd.ng/trip

# Absolute path, not relative - the notification-service systemd unit has no
# WorkingDirectory set, so a relative path here would resolve against "/",
# not the app's own directory. See docs/firebase-fcm.md for how to get this
# file onto the VPS. If it's missing/unreadable, FirebaseConfig logs an error
# and the service still starts - pushes are just skipped, DB notifications
# still save.
FIREBASE_CREDENTIALS_PATH=/opt/coryd-dev/firebase-service-account.json

# Ops reports (notification-service) - daily 06:00, weekly Mon 06:05, monthly 1st 06:10
REPORT_ENABLED=true
REPORT_TIMEZONE=Africa/Lagos
# Comma-separated - add as many as you need
REPORT_RECIPIENTS=hello@coryd.ng,victor.oyeks@coryd.ng
REPORT_LOGO_URL=

# Driver document gate: STRICT | GRACE | OFF
DRIVER_VERIFICATION_ENFORCEMENT=GRACE
DRIVER_VERIFICATION_GRACE_DAYS=30
# Identity/vehicle gate: SUBMITTED | APPROVED (APPROVED needs an ops reviewer)
DRIVER_PREREQUISITE_LEVEL=APPROVED

# Prembly driver identity checks (FRSC licence + vehicle plate register).
# Leave PREMBLY_ENABLED=false until a test key is in hand - with it off, every item stays
# pending for ops exactly as it did before. Test and live share one host; the key alone picks
# which, so a live key here bills you for real. Never commit a real key.
PREMBLY_ENABLED=false
PREMBLY_BASE_URL=https://api.prembly.com
PREMBLY_API_KEY=
# How close the FRSC name must be to what the driver typed, 0-1
PREMBLY_NAME_MATCH_THRESHOLD=0.85
PREMBLY_CROSS_CHECK_VEHICLE=true

# auto (T+1) | weekly | monthly. Never "manual" - Paystack treats that as conditional release.
PAYSTACK_SETTLEMENT_SCHEDULE=weekly
# Must stay inside the settlement cycle, or a trip can depart after the driver has been paid
TRIP_MAX_DAYS_AHEAD=3
# Who pays Paystack's fee on a split charge (account | subaccount | all). Verify in test mode first.
PAYSTACK_SPLIT_FEE_BEARER=
# Paystack test mode only resolves 3 real bank accounts a day. 001 is Paystack's test bank: accounts
# are sent to Paystack as that bank while the driver's own details are stored and shown. Ignored with
# a live (sk_live_) key. Leave empty to test against real banks.
PAYSTACK_TEST_BANK_CODE=001
